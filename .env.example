# Discord Bot Credentials
# Get your bot token and application ID from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Optional: Specific Server (Guild) ID for instant slash command registration (without waiting for global propagation)
GUILD_ID=

# Optional: Specific channel ID where welcome & nickname prompt messages should be sent.
# If left blank, the bot will automatically use the server's default system channel or a channel named "welcome" or "general".
WELCOME_CHANNEL_ID=
